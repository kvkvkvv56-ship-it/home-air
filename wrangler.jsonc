{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-air",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    {
      "binding": "HOME_AIR",
      "id": "bdeaaa381c5d4a11918eb6ecc28489e6"
    }
  ],

  "routes": [
    { "pattern": "home.kvkvkvv.site", "custom_domain": true }
  ]
}
